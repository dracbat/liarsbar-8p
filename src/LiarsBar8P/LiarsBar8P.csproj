<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LiarsBar8P</AssemblyName>
    <Version>0.25.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
    <!-- Without these the compiler stamps the absolute build path into the assembly, and
         that ships to everyone who downloads it. No symbol file, and any source path the
         compiler still records is rewritten to a relative one. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Liar's Bar</GameDir>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <Core>$(GameDir)\BepInEx\core</Core>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx / Harmony / Il2CppInterop -->
    <Reference Include="BepInEx.Core"><HintPath>$(Core)\BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(Core)\BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Core)\0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(Core)\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(Core)\Il2CppInterop.Common.dll</HintPath></Reference>

    <!-- Game + engine -->
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Interop)\Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Interop)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Mirror"><HintPath>$(Interop)\Mirror.dll</HintPath></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(Interop)\com.rlabrecque.steamworks.net.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Interop)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Interop)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Interop)\UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Interop)\UnityEngine.AudioModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Interop)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Interop)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Interop)\UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Interop)\UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Interop)\UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Interop)\Unity.TextMeshPro.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)"><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    The version is written twice: here, and as a const in Plugin.cs, because the BepInPlugin
    attribute needs a compile-time constant and cannot read this one. They drifted apart
    once - v0.25.0 shipped calling itself v0.24.0, which put the wrong number in the corner
    of the screen and, far worse, made the version handshake tell a genuine v0.24.0 player
    that their build matched. Everyone in a lobby must run the same build, and that check is
    what enforces it, so the two numbers disagreeing is a shipping defect, not a typo.

    This refuses to build when they disagree.
  -->
  <Target Name="VersionsMustAgree" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Plugin.cs'))</_PluginSource>
      <_WantedLine>public const string Version = "$(Version)";</_WantedLine>
    </PropertyGroup>
    <Error Condition="!$(_PluginSource.Contains('$(_WantedLine)'))"
           Text="Plugin.cs does not declare version $(Version). The number shown in game and used by the version handshake comes from Plugin.cs, so it must match &lt;Version&gt; in this file. Expected to find: $(_WantedLine)" />
  </Target>

</Project>























